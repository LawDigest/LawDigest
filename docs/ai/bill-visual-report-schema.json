{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lawdigest.kr/schemas/bill-visual-report.v1.json",
  "title": "Lawdigest Bill Visual Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "status", "billId", "billName", "generatedAt", "audience", "tone", "evidence", "blocks"],
  "properties": {
    "version": { "const": "1.0" },
    "status": { "type": "string", "enum": ["ready", "needs_review"] },
    "billId": { "type": "string", "minLength": 1 },
    "billName": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "audience": { "const": "general_public" },
    "tone": { "const": "neutral_explanatory" },
    "qualityGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredEvidenceSatisfied", "notes"],
      "properties": {
        "requiredEvidenceSatisfied": { "type": "boolean" },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidenceItem" }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/summaryCallout" },
          { "$ref": "#/$defs/changePoints" },
          { "$ref": "#/$defs/beforeAfter" },
          { "$ref": "#/$defs/impactList" },
          { "$ref": "#/$defs/processTimeline" },
          { "$ref": "#/$defs/voteChart" },
          { "$ref": "#/$defs/lawLinks" },
          { "$ref": "#/$defs/termGlossary" },
          { "$ref": "#/$defs/sourceNotes" }
        ]
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_\\-]*$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 40 },
    "evidenceRefs": { "type": "array", "items": { "type": "string" } },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "tool", "status", "retrievedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "source": {
          "type": "string",
          "enum": ["open_assembly", "law_molit", "national_law_center", "lawdigest_db", "manual_fixture"]
        },
        "tool": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["available", "missing", "failed", "not_applicable"] },
        "url": { "type": "string" },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "fields": { "type": "array", "items": { "type": "string" } },
        "note": { "type": "string" }
      }
    },
    "summaryCallout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "body", "evidenceRefs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "summary_callout" },
        "title": { "$ref": "#/$defs/title" },
        "body": { "type": "string", "minLength": 1, "maxLength": 180 },
        "tone": { "type": "string", "enum": ["info", "caution", "positive", "neutral"] },
        "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" }
      }
    },
    "changePoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "items", "evidenceRefs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "change_points" },
        "title": { "$ref": "#/$defs/title" },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "text"],
            "properties": {
              "label": { "type": "string", "maxLength": 18 },
              "text": { "type": "string", "maxLength": 120 }
            }
          }
        },
        "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" }
      }
    },
    "beforeAfter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "before", "after", "evidenceRefs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "before_after" },
        "title": { "$ref": "#/$defs/title" },
        "before": { "type": "string", "maxLength": 160 },
        "after": { "type": "string", "maxLength": 160 },
        "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" }
      }
    },
    "impactList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "items", "evidenceRefs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "impact_list" },
        "title": { "$ref": "#/$defs/title" },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target", "effect"],
            "properties": {
              "target": { "type": "string", "maxLength": 24 },
              "effect": { "type": "string", "maxLength": 120 }
            }
          }
        },
        "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" }
      }
    },
    "processTimeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "steps", "evidenceRefs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "process_timeline" },
        "title": { "$ref": "#/$defs/title" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "status"],
            "properties": {
              "label": { "type": "string", "maxLength": 20 },
              "status": { "type": "string", "enum": ["done", "current", "pending", "unknown"] },
              "date": { "type": "string" }
            }
          }
        },
        "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" }
      }
    },
    "voteChart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "total", "approved", "rejected", "abstained", "evidenceRefs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "vote_chart" },
        "title": { "$ref": "#/$defs/title" },
        "total": { "type": "integer", "minimum": 0 },
        "approved": { "type": "integer", "minimum": 0 },
        "rejected": { "type": "integer", "minimum": 0 },
        "abstained": { "type": "integer", "minimum": 0 },
        "caption": { "type": "string", "maxLength": 80 },
        "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" }
      }
    },
    "lawLinks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "items", "evidenceRefs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "law_links" },
        "title": { "$ref": "#/$defs/title" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "relation"],
            "properties": {
              "name": { "type": "string", "maxLength": 80 },
              "relation": { "type": "string", "maxLength": 40 },
              "url": { "type": "string" }
            }
          }
        },
        "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" }
      }
    },
    "termGlossary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "terms", "evidenceRefs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "term_glossary" },
        "title": { "$ref": "#/$defs/title" },
        "terms": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["term", "plainText"],
            "properties": {
              "term": { "type": "string", "maxLength": 32 },
              "plainText": { "type": "string", "maxLength": 120 }
            }
          }
        },
        "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" }
      }
    },
    "sourceNotes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "notes", "evidenceRefs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "source_notes" },
        "title": { "$ref": "#/$defs/title" },
        "notes": {
          "type": "array",
          "items": { "type": "string", "maxLength": 180 }
        },
        "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" }
      }
    }
  }
}
